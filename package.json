{
  "name": "midnight-level-2",
  "version": "0.2.0",
  "description": "Umbra (Waxing Crescent) — the Level 1 privacy notice-board contract wired to a real frontend UI with the Lace wallet on Midnight testnet. Midnight Academy Level 2.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20 <25"
  },
  "scripts": {
    "predev": "npm run sync-zk",
    "dev": "vite",
    "prebuild": "npm run sync-zk",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "compile": "compact compile contract/umbra.compact managed/umbra && node scripts/compile-summary.mjs",
    "sync-zk": "node scripts/sync-zk-assets.mjs",
    "proof-server": "docker run --rm -p 6300:6300 midnightntwrk/proof-server:8.0.3 -- midnight-proof-server -v"
  },
  "keywords": [
    "midnight",
    "compact",
    "zero-knowledge",
    "privacy",
    "zk",
    "lace",
    "dapp"
  ],
  "license": "MIT",
  "dependencies": {
    "@midnight-ntwrk/compact-js": "2.5.0",
    "@midnight-ntwrk/compact-runtime": "0.15.0",
    "@midnight-ntwrk/dapp-connector-api": "4.0.1",
    "@midnight-ntwrk/ledger-v8": "8.0.3",
    "@midnight-ntwrk/midnight-js-contracts": "4.0.4",
    "@midnight-ntwrk/midnight-js-fetch-zk-config-provider": "4.0.4",
    "@midnight-ntwrk/midnight-js-http-client-proof-provider": "4.0.4",
    "@midnight-ntwrk/midnight-js-indexer-public-data-provider": "4.0.4",
    "@midnight-ntwrk/midnight-js-level-private-state-provider": "4.0.4",
    "@midnight-ntwrk/midnight-js-network-id": "4.0.4",
    "@midnight-ntwrk/midnight-js-types": "4.0.4",
    "@midnight-ntwrk/midnight-js-utils": "4.0.4",
    "@midnight-ntwrk/wallet-sdk-address-format": "3.1.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vite-plugin-node-polyfills": "^0.22.0",
    "vite-plugin-top-level-await": "^1.4.4",
    "vite-plugin-wasm": "^3.3.0"
  }
}
